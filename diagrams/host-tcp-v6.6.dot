digraph tcp {
 graph [rankdir=TB,bgcolor="white",pad="0.4",nodesep="0.3",ranksep="0.3",compound=true,label="Linux v6.6 • host netns • IPv4 TCP • expanded function paths • ixgbe driver example",labelloc=t,fontsize=22];
 node [shape=box,style="rounded,filled",fillcolor="#eef2f6",fontname="sans-serif",fontsize=12,margin="0.14,0.09"];
 edge [fontname="sans-serif",fontsize=10,color="#475569"];
 subgraph cluster_rx {
 label="INGRESS: physical NIC → IPv4 → TCP → user receive";color="#94a3b8";
 irq [label="driver IRQ handler → napi_schedule()"];
 softirq [label="net_rx_action()"];
 poll [label="napi_poll() → __napi_poll()"];
 driver [label="driver-specific napi poll()"];
 native [label="Native XDP attached?",shape=diamond,fillcolor="#dcfce7"];
 xdp_run [label="driver-specific run_xdp()\nbpf_prog_run_xdp()\nPASS continues; DROP/TX/REDIRECT diverts",fillcolor="#dcfce7"];
 noxdp [label="No native XDP program\ncontinue to skb construction"];
 gro [label="napi_gro_receive()"];
 devgro [label="dev_gro_receive()"];
 finish [label="napi_skb_finish(): GRO result",shape=diamond];
 normal [label="GRO_NORMAL → gro_normal_one()\n→ gro_normal_list() when NAPI flushes"];
 flush [label="napi_complete_done() / poll completion\n→ napi_gro_flush() → gro_normal_list()",fillcolor="#fef9c3"];
 held [label="GRO_HELD: stored in GRO hash\nGRO_MERGED: input merged, no separate delivery"];
 mergedfree [label="GRO_MERGED_FREE\nfree merged input skb; no independent IP delivery"];
 complete [label="Later flush / completion of aggregate\nnapi_gro_complete() → gro_normal_one()"];
 receive [label="netif_receive_skb_internal()\nOR netif_receive_skb_list_internal()"];
 rps [label="RPS enabled and target CPU differs?",shape=diamond];
 backlogcpu [label="get_rps_cpu()\n→ enqueue_to_backlog(skb, cpu)\nreturn; target CPU processes later",fillcolor="#fef9c3"];
 localcpu [label="No RPS handoff\ncontinue on current CPU"];
 receive2 [label="__netif_receive_skb() / list variants"];
 core [label="__netif_receive_skb_core()"];
 generic [label="Generic XDP attached?",shape=diamond,fillcolor="#dcfce7"];
 genericrun [label="do_xdp_generic() → netif_receive_generic_xdp()\n→ bpf_prog_run_generic_xdp()\nPASS continues; other actions divert",fillcolor="#dcfce7"];
 nogeneric [label="No generic XDP program\ncontinue to packet taps"];
 taps [label="ptype_all / device taps\ndeliver_skb() → packet_rcv() / tpacket_rcv()"];
 tcin [label="sch_handle_ingress()",fillcolor="#dcfce7"];
 tcxin [label="tcx_run() [if TCX enabled]\nnon-UNSPEC → ingress verdict\nUNSPEC / no TCX → tc_run() → tcf_classify()\n→ cls_bpf_classify() → bpf_prog_run()",fillcolor="#dcfce7"];
 nfin [label="nf_ingress() → nf_hook_ingress()\nNETDEV ingress / nft netdev or inet",fillcolor="#f3e8ff"];
 demux [label="VLAN / rx_handler / protocol demux\nIPv4 handler selected"];
 iplist [label="Batch handler: ip_list_rcv()\n→ ip_rcv_core() for each skb\ngroup by device / netns"];
 sublist [label="ip_sublist_rcv()"];
 prelist [label="NF_HOOK_LIST(PREROUTING)\nsame priority sequence as single-packet hook\nqueued packets may later use ip_rcv_finish()",fillcolor="#ffedd5"];
 listfinish [label="ip_list_rcv_finish()\n→ l3mdev_ip_rcv() per remaining skb\n→ ip_rcv_finish_core()"];
 subfinish [label="ip_sublist_rcv_finish()\n→ dst_input() for each grouped skb"];
 delivery [label="Successful core return to caller\nsingle skb: ip_rcv_finish() → dst_input()\nbatch: group by dst → ip_sublist_rcv_finish()",shape=diamond];
 iprcv [label="Single-packet handler: ip_rcv()"];
 ipcore [label="ip_rcv_core()\nIPv4 header validation"];
 pre [label="NF_HOOK(NF_INET_PRE_ROUTING) = PREROUTING\ndefrag -400 → raw -300 → conntrack -200\n→ mangle -150 → nat/DNAT -100",fillcolor="#ffedd5"];
 ipfinish [label="ip_rcv_finish()"];
 ipfinishcore [label="ip_rcv_finish_core()"];
 early [label="tcp_v4_early_demux()\nif enabled / applicable"];
 validdst [label="skb_valid_dst()?",shape=diamond];
 route [label="ip_route_input_noref()\nonly without usable cached destination"];
 dstin [label="dst_input()"];
 local [label="ip_local_deliver()"];
 defrag [label="ip_defrag()\nif fragments remain"];
 input [label="NF_HOOK(NF_INET_LOCAL_IN) = INPUT\nmangle -150 → filter 0 → [security +50]\n→ nat/SNAT +100 → conntrack confirm INT_MAX",fillcolor="#ffedd5"];
 localfinish [label="ip_local_deliver_finish()"];
 protocol [label="ip_protocol_deliver_rcu()\nXFRM policy / protocol selection"];
 tcprcv [label="tcp_v4_rcv()\nheader / checksum setup"];
 lookup [label="__inet_lookup_skb()\ncached socket / established hash / listener"];
 stateclass [label="Socket state after lookup",shape=diamond];
 establishedpath [label="ESTABLISHED: policy / MD5 / socket filter\nthen socket ownership and tcp_v4_do_rcv()"];
 requestfilter [label="TCP_NEW_SYN_RECV / LISTEN: policy / MD5 / socket filter"];
 requestcheck [label="tcp_check_req() / request socket transition\nchild process or discard/reset"];
 requestpath [label="TCP_NEW_SYN_RECV / LISTEN\nrequest or listener checks\nthen tcp_check_req() / tcp_v4_do_rcv()"];
 timepath [label="TCP_TIME_WAIT\nXFRM/checksum → tcp_timewait_state_process()"];
 nosocket [label="No socket\nXFRM/checksum → optional tcp_v4_send_reset()\nthen drop skb"];
 policy [label="xfrm4_policy_check()\ntcp_inbound_md5_hash() / nf_reset_ct()"];
 tcpfilter [label="tcp_filter()"];
 skfilter [label="sk_filter_trim_cap()"];
 cgin [label="BPF_CGROUP_RUN_PROG_INET_INGRESS\n→ __cgroup_bpf_run_filter_skb()",fillcolor="#dcfce7"];
 securityin [label="security_sock_rcv_skb()"];
 sockfilter [label="bpf_prog_run_save_cb()\nif sk_filter installed (socket cBPF/eBPF)",fillcolor="#dcfce7"];
 own [label="sock_owned_by_user()?",shape=diamond];
 backlog [label="tcp_add_backlog()\nqueued until socket release"];
 release [label="release_sock() → __release_sock()\n→ sk_backlog_rcv()"];
 dorcv [label="tcp_v4_do_rcv()"];
 established [label="tcp_rcv_established()"];
 prediction [label="TCP header prediction matches?",shape=diamond];
 fast [label="fast path: checksum / ACK processing\ntcp_queue_rcv() for payload"];
 validate [label="slow path: tcp_validate_incoming()\n→ tcp_ack() / tcp_urg() as needed"];
 data [label="tcp_data_queue()"];
 ofo [label="tcp_data_queue_ofo()\nstore out-of-order skb in RB tree"];
 ofodrain [label="Later in-order data: tcp_ofo_queue()\n→ tcp_try_coalesce() / tcp_rcv_nxt_update()\n→ __skb_queue_tail() OR kfree_skb_partial()\nFIN may call tcp_fin(); duplicates may drop"];
 recvqueue [label="Socket receive queue (data structure)\nnot a function call",shape=cylinder];
 queue [label="tcp_queue_rcv()\nreceive queue / coalescing"];
 ready [label="tcp_data_ready() → sk->sk_data_ready()\nusually sock_def_readable()\nwake readers when conditions met"];
 recv [label="read / recv / recvfrom / recvmsg\nseparate application syscall"];
 recvmsg [label="sock_recvmsg()\nsecurity_socket_recvmsg()\nsock_recvmsg_nosec()"];
 inetrecv [label="inet_recvmsg()"];
 tcprecv [label="tcp_recvmsg()"];
 lockedrecv [label="tcp_recvmsg_locked()"];
 copy [label="skb_copy_datagram_msg()\n→ skb_copy_datagram_iter()\ncopy data to user / consume queue"];
 irq -> softirq [label="schedules softirq, not direct call"]; softirq -> poll -> driver -> native;
 native -> xdp_run [label="yes"]; native -> noxdp [label="no"]; xdp_run -> gro [label="XDP_PASS"]; noxdp -> gro;
 gro -> devgro -> finish;
 finish -> normal [label="GRO_NORMAL"]; normal -> receive;
 finish -> held [label="HELD / MERGED"]; held -> complete [style=dashed,label="aggregate later delivered"]; complete -> normal; flush -> normal [style=dashed,label="pending GRO list delivery"];
 finish -> mergedfree [label="MERGED_FREE"];
 receive -> rps;
 rps -> backlogcpu [label="yes: hand off"]; rps -> localcpu [label="no"]; backlogcpu -> core [style=dashed,label="later backlog poll"];
 localcpu -> receive2 -> core -> generic;
 generic -> genericrun [label="yes"]; generic -> nogeneric [label="no"]; genericrun -> taps [label="XDP_PASS"]; nogeneric -> taps;
 taps -> tcin -> tcxin -> nfin -> demux;
 demux -> iprcv [label="single handler"]; iprcv -> ipcore -> pre -> ipfinish -> ipfinishcore;
 demux -> iplist [label="list handler"]; iplist -> sublist -> prelist -> listfinish -> ipfinishcore;
 prelist -> ipfinish [style=dashed,label="NFQUEUE reinjection continuation"];
 ipfinishcore -> early [style=dashed]; early -> validdst; ipfinishcore -> validdst [label="early demux skipped"]; validdst -> delivery [label="yes: cached route"]; validdst -> route [label="no"]; route -> delivery;
 delivery -> dstin [label="single"]; delivery -> subfinish [label="batch"]; subfinish -> dstin; dstin -> local -> defrag -> input -> localfinish -> protocol -> tcprcv -> lookup -> stateclass;
 stateclass -> establishedpath [label="ESTABLISHED"]; stateclass -> requestpath [label="NEW_SYN_RECV / LISTEN"]; stateclass -> timepath [label="TIME_WAIT"]; stateclass -> nosocket [label="lookup miss"];
 establishedpath -> policy; requestpath -> requestfilter;
 requestfilter -> policy [style=dashed,label="shared policy/check stage"];
 policy -> tcpfilter -> skfilter -> cgin -> securityin -> sockfilter;
 sockfilter -> own [label="established socket"];
 sockfilter -> requestcheck [label="request/listener path"];
 requestcheck -> req [style=dashed,label="request accepted / child socket"];
 timepath -> timewait [style=dashed,label="time-wait handler"]; nosocket -> reset [style=dashed,label="no-socket handler"];
 own -> dorcv [label="no"]; own -> backlog [label="yes"]; backlog -> release [style=dashed,label="later"]; release -> dorcv;
 dorcv -> established [label="ESTABLISHED"]; established -> prediction; prediction -> fast [label="yes"]; prediction -> validate [label="no"]; validate -> data; data -> queue [label="in order"]; data -> ofo [label="out of order"]; data -> ofodrain [style=dashed,label="in-order data fills gap"]; ofo -> ofodrain [style=dashed,label="stored skb processed later, not direct call"]; ofodrain -> recvqueue; queue -> recvqueue; fast -> ready; recvqueue -> ready [style=dashed,label="caller may notify reader"];
 ready -> recv [style=dashed,label="wakeup / independent read"]; recv -> recvmsg -> inetrecv -> tcprecv -> lockedrecv -> copy;
 }
 subgraph cluster_states {
 label="TCP state / response branches (conditional; not serial established-data processing)";color="#ca8a04";
 node [fillcolor="#fef9c3"];
 state [label="tcp_rcv_state_process()\nnon-ESTABLISHED TCP state machine"];
 listen [label="LISTEN: tcp_v4_conn_request()\n→ tcp_conn_request()\n→ tcp_v4_send_synack()"];
 req [label="TCP_NEW_SYN_RECV: tcp_check_req()\n→ tcp_v4_syn_recv_sock() / tcp_child_process()"];
 timewait [label="TCP_TIME_WAIT: tcp_timewait_state_process()\nACK / reset / drop / new SYN handling"];
 reset [label="No socket / invalid segment:\ntcp_v4_send_reset() if allowed"];
 ack [label="tcp_ack_snd_check() / delayed ACK\n→ tcp_send_ack() [timer also possible]"];
 retrans [label="tcp_retransmit_timer()\n→ tcp_retransmit_skb()\n→ __tcp_retransmit_skb()"];
 dorcv -> state [label="non-ESTABLISHED state"]; state -> listen [style=dashed]; requestpath -> req [style=dashed,label="request socket"]; req -> accept [style=dashed,label="accept queue"]; accept -> requestcheck [style=dashed,label="child socket established"];
 established -> ack [style=dashed,label="ACK needed"];
 }
 subgraph cluster_tx {
 label="EGRESS: application TCP send → IPv4 → L2 → NIC";color="#94a3b8";
 node [fillcolor="#eef2f6"];
 send [label="send/sendto → __sys_sendto()\nsendmsg → ___sys_sendmsg()\nwrite → sock_write_iter()"];
 socksend [label="sock_sendmsg()\n→ security_socket_sendmsg()\n→ sock_sendmsg_nosec()"];
 inet [label="inet_sendmsg()"];
 tcpsend [label="tcp_sendmsg()"];
 locked [label="tcp_sendmsg_locked()\ncopy / build skb, write queue"];
 push [label="tcp_push()"];
 pending [label="__tcp_push_pending_frames()"];
 write [label="tcp_write_xmit()\ncwnd / rwnd / pacing / Nagle / TSO decisions"];
 transmit [label="tcp_transmit_skb()"];
 transmit2 [label="__tcp_transmit_skb()\nbuild TCP header / checksum / TCP options"];
 ipqueue [label="icsk_af_ops->queue_xmit\n→ ip_queue_xmit()"];
 ipqueue2 [label="__ip_queue_xmit()"];
 outroute [label="cached dst OR ip_route_output_ports()\nconstruct IPv4 header",shape=diamond];
 noroute [label="route error / strict-route failure\nIPSTATS OUTNOROUTES\nkfree_skb_reason() → -EHOSTUNREACH",fillcolor="#fee2e2"];
 localout [label="ip_local_out()"];
 l3drop [label="l3mdev_ip_out() consumes skb\nreturn 0: no Netfilter OUTPUT",fillcolor="#fee2e2"];
 localout2 [label="__ip_local_out()"];
 output [label="nf_hook(NF_INET_LOCAL_OUT) = OUTPUT\ndefrag -400 → raw -300 → conntrack -200\n→ mangle -150 → nat/DNAT -100\n→ filter 0 → [security +50]",fillcolor="#ffedd5"];
 outdrop [label="OUTPUT verdict DROP/QUEUE/STOLEN\nstop or divert skb",fillcolor="#fee2e2"];
 reroute [label="mangle / NAT callback may invoke\nip_route_me_harder() if mark/address changed",fillcolor="#fef9c3"];
 dstout [label="dst_output()"];
 ipout [label="ip_output()"];
 post [label="NF_HOOK_COND(NF_INET_POST_ROUTING) = POSTROUTING\nmangle -150 → nat/SNAT +100\n→ conntrack confirm INT_MAX",fillcolor="#ffedd5"];
 postdrop [label="POSTROUTING verdict DROP/QUEUE/STOLEN\nstop or divert skb",fillcolor="#fee2e2"];
 postskip [label="IPSKB_REROUTED: skip repeated POSTROUTING hook\ncontinue directly to ip_finish_output()",fillcolor="#fef9c3"];
 ipfinishout [label="ip_finish_output(): cgroup egress verdict",shape=diamond];
 cgdrop [label="BPF cgroup egress reject\n→ kfree_skb_reason() / drop",fillcolor="#fee2e2"];
 cgout [label="BPF_CGROUP_RUN_PROG_INET_EGRESS\n→ __cgroup_bpf_run_filter_skb()",fillcolor="#dcfce7"];
 finishout [label="__ip_finish_output()"];
 gso [label="ip_finish_output_gso()\nor ip_fragment()",fillcolor="#fef9c3"];
 finishout2 [label="ip_finish_output2()"];
 gw [label="ip_neigh_for_gw()"];
 neigh [label="neigh_output():\n!skip_cache && NUD_CONNECTED && hh_len?",shape=diamond];
 hh [label="neigh_hh_output()\ncached L2 header → dev_queue_xmit()"];
 noutput [label="READ_ONCE(n->output)(n, skb)\ncallback selected by neighbour state",shape=diamond];
 directneigh [label="neigh_direct_output()\n→ dev_queue_xmit()"];
 blackhole [label="neigh_blackhole()\n→ kfree_skb() / -ENETDOWN",fillcolor="#fee2e2"];
 event [label="neigh_event_send() result",shape=diamond];
 waitarp [label="Resolution pending: skb queued / ARP probe\nlater neighbour update may release queue"];
 neighdrop [label="Failed resolution / queue limit / dead neighbour\nerror report / skb disposal",fillcolor="#fee2e2"];
 connected [label="neigh_connected_output()\nconstruct L2 header → dev_queue_xmit()"];
 resolve [label="neigh_resolve_output()\n→ neigh_event_send()\nmay transmit immediately, not always unresolved",fillcolor="#fef9c3"];
 devqueue [label="dev_queue_xmit()"];
 devqueue2 [label="__dev_queue_xmit()"];
 netegress [label="nf_hook_egress(): nft NETDEV egress",shape=diamond,fillcolor="#f3e8ff"];
 nfegressdrop [label="nft egress DROP/QUEUE/STOLEN\nstop or divert skb",fillcolor="#fee2e2"];
 nfegressok [label="nft egress ACCEPT\ncontinue to TC egress",fillcolor="#f3e8ff"];
 tcegress [label="sch_handle_egress(): TCX → TC fallback",shape=diamond,fillcolor="#dcfce7"];
 tcredirect [label="TC egress REDIRECT\nskb_do_redirect() / NET_XMIT_SUCCESS\nno qdisc for this skb",fillcolor="#dcfce7"];
 tcdrop [label="TC egress SHOT\nkfree_skb_reason() / NET_XMIT_DROP",fillcolor="#fee2e2"];
 tcconsume [label="TC egress STOLEN/QUEUED/TRAP/CONSUMED\nconsume or divert skb",fillcolor="#fef9c3"];
 tcpass [label="TC egress pass / UNSPEC\ncontinue to TX queue selection",fillcolor="#dcfce7"];
 pick [label="netdev_core_pick_tx()\nselect TX queue / qdisc"];
 enqueue [label="__dev_xmit_skb(): qdisc enqueue or bypass",shape=diamond];
 bypass [label="TCQ_F_CAN_BYPASS + qdisc empty\n→ sch_direct_xmit(validate=true)\nthen qdisc run if needed",fillcolor="#fef9c3"];
 enqueued [label="q->enqueue()\n→ qdisc_run() / __qdisc_run()",fillcolor="#eef2f6"];
 qrun [label="qdisc_run() → __qdisc_run()"];
 restart [label="qdisc_restart()\n→ dequeue_skb()"];
 direct [label="sch_direct_xmit(): validate?",shape=diamond];
 again [label="XFRM offload: validate reports again?",shape=diamond];
 requeueagain [label="dev_requeue_skb()\nreturn false; retry from qdisc"];
 validskb [label="validated skb exists?",shape=diamond];
 txstate [label="netif_xmit_frozen_or_stopped()?",shape=diamond];
 missed [label="qdisc_maybe_clear_missed()\nno driver call this round"];
 result [label="driver return: dev_xmit_complete(ret)?",shape=diamond];
 busy [label="NETDEV_TX_BUSY / incomplete skb chain\ndev_hard_start_xmit() returns unconsumed skb list\ndev_requeue_skb() → retry later",fillcolor="#fee2e2"];
 sentchain [label="Some skb chain elements consumed\nreturned tail remains owned by qdisc",fillcolor="#fef9c3"];
 done [label="return true\ntransmit completed or skb consumed"];
 validateout [label="validate_xmit_skb_list()\niterate skb list"];
 validatesingle [label="validate_xmit_skb()\nsoftware GSO/checksum fallback if needed"];
 hard [label="dev_hard_start_xmit()\nloops skb list → xmit_one()"];
 one [label="xmit_one()\n→ dev_queue_xmit_nit() [AF_PACKET TX tap first]\n→ trace_net_dev_start_xmit()\n→ netdev_start_xmit()\n→ __netdev_start_xmit()\n→ ndo_start_xmit()\n→ trace_net_dev_xmit()"];
 start [label="TX completion / driver return\nconsumed or incomplete skb returned",shape=note];
 ndo [label="driver-specific TX DMA ring / completion\nixgbe_xmit_frame() → ixgbe_tx_map()\ncompletion later reclaims skb"];
 send -> socksend -> inet -> tcpsend -> locked -> push -> pending -> write -> transmit -> transmit2 -> ipqueue -> ipqueue2 -> outroute;
 outroute -> noroute [label="route error"]; outroute -> localout [label="route available / header built"]; localout -> localout2; localout2 -> l3drop [label="l3mdev consumes"]; localout2 -> output [label="hook runs"];
 output -> outdrop [label="DROP/QUEUE/STOLEN"]; output -> dstout [label="ACCEPT → dst_output()"];
 reroute -> dstout [style=dashed,label="route changed → dst_output()"];
 dstout -> ipout -> post;
 post -> postdrop [label="DROP/QUEUE/STOLEN"]; post -> ipfinishout [label="normal hook continuation"];
 post -> postskip [label="rerouted flag / hook condition false"]; postskip -> ipfinishout;
 ipfinishout -> cgout [label="run cgroup program"]; cgout -> cgdrop [label="reject"]; cgout -> finishout [label="allow / congestion notification"]; finishout -> finishout2 [label="ordinary packet"]; finishout -> gso [label="oversized / GSO"]; gso -> finishout2;
 finishout2 -> gw -> neigh; neigh -> hh [label="cache usable"]; hh -> devqueue;
 neigh -> noutput [label="otherwise"]; noutput -> connected [label="neigh_connected_output"]; noutput -> resolve [label="neigh_resolve_output"]; noutput -> directneigh [label="neigh_direct_output"]; noutput -> blackhole [label="neigh_blackhole"]; directneigh -> devqueue; blackhole -> neighdrop;
 resolve -> event; event -> devqueue [label="0 and valid L2 header: immediate output"]; event -> waitarp [label="nonzero: queued / consumed"]; event -> neighdrop [style=dashed,label="0 but L2 header construction fails"]; connected -> neighdrop [style=dashed,label="L2 header construction fails"]; waitarp -> noutput [style=dashed,label="later resolution succeeds"]; waitarp -> neighdrop [style=dashed,label="failure / eviction"]; connected -> devqueue -> devqueue2 -> netegress;
 netegress -> nfegressdrop [label="drop/divert"]; netegress -> nfegressok [label="accept"];
 nfegressok -> tcegress; tcegress -> tcredirect [label="REDIRECT"]; tcegress -> tcdrop [label="SHOT"]; tcegress -> tcconsume [label="STOLEN/QUEUED/TRAP/CONSUMED"]; tcegress -> tcpass [label="pass / UNSPEC"];
 tcpass -> pick -> enqueue; enqueue -> bypass [label="bypass eligible"]; enqueue -> enqueued [label="normal enqueue"]; bypass -> direct [style=dashed,label="direct transmit"]; enqueued -> qrun -> restart -> direct; direct -> validateout [label="validate=true"]; direct -> validskb [label="validate=false: already validated skb"];
 validateout -> again; again -> requeueagain [label="yes: XFRM offload"]; requeueagain -> qrun [style=dashed,label="retry"]; again -> validskb [label="no / feature off"];
 validatesingle -> validskb; validskb -> txstate [label="yes"]; validskb -> done [label="no: no driver call"];
 txstate -> hard [label="no"]; txstate -> missed [label="yes"]; missed -> result [label="skb consumed / no driver call"];
 hard -> one -> ndo -> start -> result;
 result -> done [label="all skb consumed"]; result -> sentchain [label="partial chain / queue stopped"]; result -> busy [label="BUSY / incomplete"]; sentchain -> busy; busy -> qrun [style=dashed,label="retry returned skb chain"];
 pick -> validatesingle [style=dashed,label="device has no qdisc / noqueue path; skips list validator"];
 }
 subgraph cluster_hooks {
 label="Inside each IPv4 Netfilter hook: actual rule dispatch (not a sixth chain)";color="#f97316";
 node [fillcolor="#ffedd5"];
 hook [label="NF_HOOK / nf_hook()\n→ nf_hook_slow(): iterate by priority"];
 legacy [label="legacy raw / mangle / filter / security table callback\n→ ipt_do_table(): match / target traversal"];
 nat [label="nf_nat_ipv4_pre_routing / local_in / local_fn / out\n→ nf_nat_ipv4_fn() → nf_nat_inet_fn()\nNEW mapping: lookup hook → ipt_do_table()\n→ nf_nat_packet() applies mapping"];
 nft [label="nft base-chain callback / family wrapper\n→ nft_do_chain(): expressions / verdicts\nHook + priority configured per base chain",fillcolor="#f3e8ff"];
 nfbpf [label="Netfilter BPF link (since 6.4)\nnf_hook_run_bpf() → bpf_prog_run()\nuser-selected hook / allowed priority",fillcolor="#dcfce7"];
 verdict [label="ACCEPT: continue other callbacks\nDROP: terminate; QUEUE/STOLEN: divert\nEnd of hook: run continuation"];
 hook -> legacy -> verdict; hook -> nat -> verdict; hook -> nft -> verdict; hook -> nfbpf -> verdict;
 pre -> hook [style=dotted,label="same dispatch model",constraint=false];
 }
 acksend [label="__tcp_send_ack()\nconstruct pure ACK"];
 ack -> acksend [style=dashed]; acksend -> transmit2; retrans -> transmit2 [style=dashed];
 subgraph cluster_hook_sequences {
 label="Per-hook expansion: iptables-legacy + conntrack callback order (when registered)";color="#f97316";
 node [fillcolor="#ffedd5"];
 pr0 [label="PREROUTING: nf_hook_slow()"];
 pr1 [label="-400 ipv4_conntrack_defrag()\n→ nf_ct_ipv4_gather_frags() → ip_defrag()"];
 pr2 [label="-300 raw: ipt_do_table()"];
 pr3 [label="-200 ipv4_conntrack_in()\n→ nf_conntrack_in()"];
 pr4 [label="-150 iptable_mangle_hook()\n→ ipt_do_table()"];
 pr5 [label="-100 nf_nat_ipv4_pre_routing()\n→ nf_nat_ipv4_fn() → nf_nat_inet_fn()\nlookup hooks on new mapping → nf_nat_packet()"];
 pr6 [label="NF_ACCEPT through remaining callbacks\n→ ip_rcv_finish()"];
 pr0 -> pr1 -> pr2 -> pr3 -> pr4 -> pr5 -> pr6;
 in0 [label="INPUT: nf_hook_slow()"];
 in1 [label="-150 iptable_mangle_hook() → ipt_do_table()"];
 in2 [label="0 filter: ipt_do_table()"];
 in3 [label="+50 security: ipt_do_table() [optional]"];
 in4 [label="+100 nf_nat_ipv4_local_in()\n→ nf_nat_ipv4_fn() → nf_nat_inet_fn()\n→ mapping lookup / nf_nat_packet()"];
 in5 [label="INT_MAX nf_confirm()\n→ nf_conntrack_confirm()\n→ __nf_conntrack_confirm() if unconfirmed"];
 in6 [label="→ ip_local_deliver_finish()"];
 in0 -> in1 -> in2 -> in3 -> in4 -> in5 -> in6;
 ou0 [label="OUTPUT: nf_hook_slow()"];
 ou1 [label="-400 ipv4_conntrack_defrag()\n→ nf_ct_ipv4_gather_frags() → ip_defrag()"];
 ou2 [label="-300 raw: ipt_do_table()"];
 ou3 [label="-200 ipv4_conntrack_local()\n→ nf_conntrack_in()"];
 ou4 [label="-150 iptable_mangle_hook()\n→ ipt_mangle_out() → ipt_do_table()\n→ ip_route_me_harder() if needed"];
 ou5 [label="-100 nf_nat_ipv4_local_fn()\n→ nf_nat_ipv4_fn() → nf_nat_inet_fn()\n→ mapping lookup / nf_nat_packet()\n→ ip_route_me_harder() if needed"];
 ou6 [label="0 filter: ipt_do_table()\n+50 security: ipt_do_table() [optional]"];
 ou7 [label="return 1 → ip_local_out()\n→ dst_output()"];
 ou0 -> ou1 -> ou2 -> ou3 -> ou4 -> ou5 -> ou6 -> ou7;
 po0 [label="POSTROUTING: nf_hook_slow()"];
 po1 [label="-150 iptable_mangle_hook() → ipt_do_table()"];
 po2 [label="+100 nf_nat_ipv4_out()\n→ nf_nat_ipv4_fn() → nf_nat_inet_fn()\n→ mapping lookup / nf_nat_packet()"];
 po3 [label="INT_MAX nf_confirm()\n→ nf_conntrack_confirm()\n→ __nf_conntrack_confirm() if unconfirmed"];
 po4 [label="→ ip_finish_output()"];
 po0 -> po1 -> po2 -> po3 -> po4;
 pre -> pr0 [style=dotted,constraint=false]; input -> in0 [style=dotted,constraint=false]; output -> ou0 [style=dotted,constraint=false]; post -> po0 [style=dotted,constraint=false];
 ct [label="nf_conntrack_in()\n→ resolve_normal_ct(): tuple/hash lookup or allocate\n→ nf_conntrack_handle_packet()\n→ nf_conntrack_tcp_packet()\nTCP conntrack state differs from socket TCP state",fillcolor="#fef9c3"];
 pr3 -> ct [style=dotted,constraint=false]; ou3 -> ct [style=dotted,constraint=false];
 xt [label="ipt_do_table(): walk chain entries\nip_packet_match() → extension match->match()\nstandard verdict/jump/RETURN OR target->target()\nExtension-dependent calls (LOG, MARK, DNAT, etc.)",fillcolor="#fef9c3"];
 legacy -> xt [style=dotted];
 nftexec [label="nft_do_chain() → expr_call_ops_eval()\n→ expression ops->eval() or optimized fast evaluator\nregisters / verdict / jump stack\nExpression list determined by installed rules",fillcolor="#f3e8ff"];
 nft -> nftexec [style=dotted];
 ordering [label="nft base chains and Netfilter BPF can be inserted\nat their configured priorities in EVERY supported hook.\nDo not append them after legacy as a fixed second firewall.\nSame-priority callback order is not a policy guarantee.\nraw_before_defrag changes raw priority to -450.\nEvery sequence assumes prior callbacks ACCEPT; otherwise it stops.",shape=note,fillcolor="#f8fafc"];
 po4 -> ordering [style=invis];
 }
 events [label="Optional socket-event BPF (not every packet):\ncgroup connect4 → tcp_v4_pre_connect() before tcp_v4_connect()\nsock_ops callbacks in TCP state/options processing\nsk_msg/sk_skb sockmap can intercept/redirect alternative data paths",shape=note,fillcolor="#dcfce7"];
 events -> tcpsend [style=dotted,constraint=false];
 note [label="Arrows summarize selected calls/continuations; dotted/dashed edges are optional or asynchronous.\nGrouping wrappers / inline macros keeps this finite: no claim of every transitive helper on all states/drivers.\nIPv4 local TCP uses PREROUTING/INPUT or OUTPUT/POSTROUTING, never FORWARD (see overview for all five chains).\nNative/generic XDP are alternatives; BPF attachments/config/modules may be absent.\nAll hook / filter stages may drop, queue or redirect; not all branches return to this diagram.\nExcluded from detailed function expansion: bridge, IPv6, XFRM, tunnels, hardware offload, full TCP errors/states.",shape=note,fillcolor="#f8fafc"];
 copy -> note [style=invis]; ndo -> note [style=invis];
 subgraph cluster_ixgbe {
 label="Concrete driver example: ixgbe / MSI-X / ordinary RX, not AF_XDP zero-copy";color="#64748b";
 node [fillcolor="#e0f2fe"];
 ixirq [label="ixgbe_msix_clean_rings()\n→ napi_schedule_irqoff()"];
 ixpoll [label="ixgbe_poll()"];
 ixrx [label="ixgbe_clean_rx_irq()\nRX descriptor / DMA page processing"];
 ixxdp [label="ixgbe_run_xdp()\n→ bpf_prog_run_xdp() [if attached]",fillcolor="#dcfce7"];
 ixskb [label="ixgbe_build_skb() OR ixgbe_construct_skb()\n→ ixgbe_rx_skb() → napi_gro_receive()"];
 ixtx [label="ixgbe_xmit_frame()\n→ __ixgbe_xmit_frame()\n→ ixgbe_xmit_frame_ring()"];
 ixspace [label="TX ring has descriptors?",shape=diamond,fillcolor="#e0f2fe"];
 ixbusy [label="ixgbe_maybe_stop_tx()\n→ NETDEV_TX_BUSY\nqdisc requeues skb",fillcolor="#fee2e2"];
 ixsetup [label="ixgbe_xmit_frame_ring()\nVLAN / timestamp / TSO / checksum / IPsec setup"];
 ixdrop [label="setup or map failure\ndev_kfree_skb_any()\nreturn NETDEV_TX_OK: consumed, no qdisc retry",fillcolor="#fee2e2"];
 ixmap [label="ixgbe_tx_map()\nDMA mapping / descriptors / tail doorbell"];
 ixok [label="NETDEV_TX_OK\nNIC owns descriptors; completion later"];
 ixcomplete [label="Later ixgbe_poll() → ixgbe_clean_tx_irq()\ncheck EOP/DD completion\n→ napi_consume_skb()\n→ DMA unmap head/pages\n→ next_to_clean / stats update\n→ wake/restart stopped TX queue"];
 ixirq -> ixpoll [style=dashed,label="NAPI scheduling"]; ixpoll -> ixrx -> ixxdp -> ixskb [label="PASS"];
 driver -> ixpoll [style=dotted,constraint=false,label="example callback"]; ixskb -> gro [style=dotted,constraint=false];
 ndo -> ixtx [style=dotted,constraint=false,label="ixgbe ndo_start_xmit"]; ixtx -> ixspace;
 ixspace -> ixbusy [label="no space"]; ixbusy -> busy [style=dashed,label="driver BUSY"]; ixspace -> ixsetup [label="space available"];
 ixsetup -> ixdrop [label="invalid VLAN / offload / map setup failure"]; ixsetup -> ixmap [label="setup succeeds"];
 ixmap -> ixdrop [label="DMA map failure"]; ixmap -> ixok [label="mapped"]; ixok -> ixcomplete [style=dashed,label="completion later"];
 }
 subgraph cluster_lifecycle {
 label="TCP lifecycle: active/passive open and normal FIN close (separate syscalls/events)";color="#ca8a04";
 node [fillcolor="#fef9c3"];
 conn [label="connect() → __sys_connect()\n→ __sys_connect_file() → inet_stream_connect()"];
 conn2 [label="__inet_stream_connect()\n→ tcp_v4_pre_connect() [cgroup connect4]\n→ tcp_v4_connect() → tcp_connect()"];
 syn [label="tcp_connect() builds SYN\n→ tcp_transmit_skb() → normal IP OUTPUT"];
 synack [label="Incoming SYN/ACK:\ntcp_rcv_state_process()\n→ tcp_rcv_synsent_state_process()\n→ tcp_finish_connect() / ACK"];
 lsn [label="listen() → inet_listen()\n→ __inet_listen_sk() → inet_csk_listen_start()"];
 accept [label="accept()/accept4() → inet_accept()\n→ inet_csk_accept() → __inet_accept()\nchild established by request-socket path"];
 fincall [label="shutdown(SHUT_WR) → inet_shutdown() → tcp_shutdown()\nOR close() → sock_close() → __sock_release()\n→ inet_release() → tcp_close() → __tcp_close()"];
 finsend [label="tcp_send_fin()\n→ __tcp_push_pending_frames()\n→ tcp_write_xmit() → TCP/IP output"];
 finrecv [label="Incoming in-order FIN:\ntcp_data_queue() → tcp_fin()\nTCP_CLOSE_WAIT / CLOSING / TIME_WAIT transitions\nACK scheduling / reader EOF wakeup"];
 abort [label="Abortive close / unread data / reset conditions:\ntcp_send_active_reset() → tcp_transmit_skb()\nNot the same as tcp_v4_send_reset() reply path"];
 conn -> conn2 -> syn; syn -> transmit [style=dotted,constraint=false]; state -> synack [style=dashed,constraint=false];
 lsn -> listen [style=dotted,constraint=false]; fincall -> finsend -> pending [style=dotted,constraint=false];
 data -> finrecv [style=dashed,constraint=false]; fincall -> abort [style=dashed]; abort -> transmit [style=dotted,constraint=false];
 }
 synackout [label="tcp_v4_send_synack()\n→ tcp_make_synack()\n→ ip_build_and_send_pkt()"];
 resetout [label="tcp_v4_send_reset()\n→ ip_send_unicast_reply()\n→ ip_append_data()\n→ ip_push_pending_frames() → ip_send_skb()"];
 listen -> synackout [style=dashed,label="SYN/ACK output"]; synackout -> localout;
 reset -> resetout [style=dashed,label="RST reply output"]; resetout -> localout;
 reuse [label="Listener SO_REUSEPORT selection\ninet_lookup_reuseport() → reuseport_select_sock()\nSK_REUSEPORT: bpf_run_sk_reuseport()\ncompat filter: run_bpf_filter() → bpf_prog_run_save_cb()\nMay fall back to hash selection",fillcolor="#dcfce7",URL="https://github.com/torvalds/linux/blob/v6.6/net/core/sock_reuseport.c",target="_blank"];
 lookup -> reuse [style=dashed,label="reuseport listener group",constraint=false];
 sklookup [label="Listener lookup only (not established hash hit):\n__inet_lookup_listener() → inet_lookup_run_sk_lookup()\n→ bpf_sk_lookup_run_v4() [BPF_PROG_TYPE_SK_LOOKUP]\nMay select socket / reject; netns attachment",fillcolor="#dcfce7",URL="https://github.com/torvalds/linux/blob/v6.6/net/ipv4/inet_hashtables.c",target="_blank"];
 requestpath -> sklookup [style=dashed,label="listener lookup",constraint=false];
 xtbpf [label="iptables -m bpf: optional rule match\nipt_do_table() → match->match()\n→ bpf_mt() / bpf_mt_v1()\n→ bpf_prog_run() / bpf_prog_run_save_cb()\nSOCKET_FILTER program returns match boolean, not NF verdict",fillcolor="#dcfce7",URL="https://github.com/torvalds/linux/blob/v6.6/net/netfilter/xt_bpf.c",target="_blank"];
 xt -> xtbpf [style=dashed,label="if matching rule uses -m bpf"];
 // Source links are also available when opening the SVG directly.
 node [target="_blank"];
 core [URL="https://github.com/torvalds/linux/blob/v6.6/net/core/dev.c"];
 devqueue2 [URL="https://github.com/torvalds/linux/blob/v6.6/net/core/dev.c"];
 pre [URL="https://github.com/torvalds/linux/blob/v6.6/net/ipv4/ip_input.c"];
 input [URL="https://github.com/torvalds/linux/blob/v6.6/net/ipv4/ip_input.c"];
 output [URL="https://github.com/torvalds/linux/blob/v6.6/net/ipv4/ip_output.c"];
 post [URL="https://github.com/torvalds/linux/blob/v6.6/net/ipv4/ip_output.c"];
 hook [URL="https://github.com/torvalds/linux/blob/v6.6/net/netfilter/core.c"];
 xt [URL="https://github.com/torvalds/linux/blob/v6.6/net/ipv4/netfilter/ip_tables.c"];
 nftexec [URL="https://github.com/torvalds/linux/blob/v6.6/net/netfilter/nf_tables_core.c"];
 ct [URL="https://github.com/torvalds/linux/blob/v6.6/net/netfilter/nf_conntrack_core.c"];
 nfbpf [URL="https://github.com/torvalds/linux/blob/v6.6/net/netfilter/nf_bpf_link.c"];
 nat [URL="https://github.com/torvalds/linux/blob/v6.6/net/netfilter/nf_nat_proto.c"];
 tcprcv [URL="https://github.com/torvalds/linux/blob/v6.6/net/ipv4/tcp_ipv4.c"];
 established [URL="https://github.com/torvalds/linux/blob/v6.6/net/ipv4/tcp_input.c"];
 transmit2 [URL="https://github.com/torvalds/linux/blob/v6.6/net/ipv4/tcp_output.c"];
 lockedrecv [URL="https://github.com/torvalds/linux/blob/v6.6/net/ipv4/tcp.c"];
}
